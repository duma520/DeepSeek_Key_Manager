# ============================================================
# DeepSeek 密钥余额管理器 —— .env 模板（可安全提交到仓库）
# 复制为 .env 后填入你自己的密钥
# ============================================================

# ---- DeepSeek 接口 ----
DEEPSEEK_API_BASE=https://api.deepseek.com
# 多个 Key 用英文逗号分隔，数量无上限
# 也支持按行写：DEEPSEEK_API_KEY_1=... / DEEPSEEK_API_KEY_2=...
DEEPSEEK_API_KEYS=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,sk-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
DEEPSEEK_TIMEOUT=20
DEEPSEEK_MAX_RETRY=2
DEEPSEEK_CONCURRENCY=5

# ---- 数据库（当前版本预留，供后续扩展使用）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
